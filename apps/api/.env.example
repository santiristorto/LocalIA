# LocalIA API — variables de entorno
# Copiar como .env y completar. Nunca versionar el .env real.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# REQUERIDO desde el Sprint 1A — Panel de Supabase: Project Settings > API > JWT Secret.
# Usado para verificar la firma de los JWT que emite Supabase Auth (middleware
# `authenticate`). Sin esto la app no arranca (validado con Zod al inicio).
SUPABASE_JWT_SECRET=

# Se completa cuando exista el primer modelo tenant-scoped (próximo sprint).
# Conexión pooleada (Supavisor) para el tráfico de la aplicación —
# Backend Architecture Specification §17.
DATABASE_URL=

# Conexión directa (no pooleada), usada exclusivamente por `prisma migrate` —
# Backend Architecture Specification §17.
DIRECT_URL=

# Se completan cuando el backend necesite operaciones administrativas sobre
# Supabase Auth (invitar empleados, revocar sesiones) — próximos sprints.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
