// LocalIA — Prisma schema
//
// Sprint 1A: `Profile`, reemplaza la tabla `users` del Database Specification
// original — la identidad y las contraseñas las gestiona Supabase Auth
// (`auth.users`, fuera del control de Prisma); `profiles` guarda únicamente
// los datos de negocio complementarios, con `id` compartido 1:1 con
// `auth.users.id`.
//
// Sprint 1B: `Tenant` / `TenantUser` — Database Specification §3.2/§4. El
// onboarding del comercio crea ambas filas en una sola transacción.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Perfil de negocio de un usuario — Backend Architecture Specification §9.
/// `id` es el mismo UUID que `auth.users.id`; la fila se crea automáticamente
/// vía trigger de Postgres al registrarse (ver migración
/// `20260715000002_profiles_auth_trigger`), nunca desde un endpoint propio
/// del backend.
model Profile {
  id           String    @id @db.Uuid
  fullName     String    @map("full_name")
  avatarUrl    String?   @map("avatar_url")
  isSuperAdmin Boolean   @default(false) @map("is_super_admin")
  mfaEnabled   Boolean   @default(false) @map("mfa_enabled")
  locale       String    @default("es-AR")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  tenantUsers TenantUser[]

  @@map("profiles")
}

enum BusinessVertical {
  restaurant
  cafe
  gym
  salon
  clinic
  retail_services
  other

  @@map("business_vertical")
}

enum TenantStatus {
  trial
  active
  suspended
  cancelled

  @@map("tenant_status")
}

/// El comercio — Database Specification §4, extendida en el Sprint 1B con
/// los campos que pide el formulario de onboarding (descripción, contacto,
/// ubicación, horario semanal, marca) que no estaban en la primera versión.
model Tenant {
  id                  String            @id @default(uuid()) @db.Uuid
  name                String
  slug                String            @unique
  businessVertical    BusinessVertical  @map("business_vertical")
  status              TenantStatus      @default(trial)
  description         String?
  phone               String?
  contactEmail        String?           @map("contact_email")
  address             String?
  city                String?
  province            String?
  country             String            @default("Argentina")
  timezone            String            @default("America/Argentina/Buenos_Aires")
  /// Horario semanal — forma: `{ mon: { isOpen, open, close }, ... }`
  /// (`packages/types/src/tenants.ts` → `openingHoursSchema`).
  openingHours         Json?            @map("opening_hours")
  logoUrl              String?          @map("logo_url")
  brandPrimaryColor    String?          @map("brand_primary_color")
  brandSecondaryColor  String?          @map("brand_secondary_color")
  trialEndsAt          DateTime?        @map("trial_ends_at")
  /// Sprint 5 (WhatsApp conectado) — un tenant puede tener su propio número
  /// de WhatsApp Business conectado. `whatsappPhoneNumberId` es lo que Meta
  /// manda en cada webhook (`entry[].changes[].value.metadata.phone_number_id`)
  /// y es lo único que permite resolver a qué tenant pertenece un mensaje
  /// entrante — de ahí el `@unique`. El App Secret / Verify Token del
  /// webhook NO están acá: son de la App de Meta (una sola, de la
  /// plataforma), no del tenant — ver `WHATSAPP_APP_SECRET`/
  /// `WHATSAPP_VERIFY_TOKEN` en `core/config/env.ts`.
  whatsappPhoneNumberId String?          @unique @map("whatsapp_phone_number_id")
  whatsappAccessToken   String?          @map("whatsapp_access_token")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  deletedAt            DateTime?        @map("deleted_at")

  tenantUsers     TenantUser[]
  menuCategories  MenuCategory[]
  menuItems       MenuItem[]
  customers       Customer[]
  aiConversations AiConversation[]
  aiMessages      AiMessage[]

  @@map("tenants")
}

enum TenantUserRole {
  owner
  manager
  employee
  readonly

  @@map("tenant_user_role")
}

enum TenantUserStatus {
  active
  invited
  revoked

  @@map("tenant_user_status")
}

/// Pivote usuario↔comercio, con el rol como atributo de la relación —
/// Database Specification §3.2. El onboarding inserta acá la primera fila
/// de cada comercio, con `role = owner`.
model TenantUser {
  id         String             @id @default(uuid()) @db.Uuid
  tenantId   String             @map("tenant_id") @db.Uuid
  userId     String             @map("user_id") @db.Uuid
  role       TenantUserRole     @default(owner)
  status     TenantUserStatus   @default(active)
  invitedBy  String?            @map("invited_by") @db.Uuid
  invitedAt  DateTime?          @map("invited_at")
  joinedAt   DateTime?          @map("joined_at")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@map("tenant_users")
}

/// Categoría del menú (ej. "Entradas", "Bebidas") — Sprint 4 (Menú).
/// `position` define el orden manual dentro del tenant; se asigna en el
/// backend al crear (al final de la lista existente) — no hay reordenamiento
/// por drag & drop todavía, ver "Posibles mejoras" del informe del sprint.
model MenuCategory {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  description String?
  position    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  MenuItem[]

  @@index([tenantId, position])
  @@map("menu_categories")
}

/// Ítem del menú — Sprint 4 (Menú). `tenantId` queda denormalizado acá
/// además de resolverse vía `category` a propósito: simplifica las políticas
/// de RLS (chequean `tenant_id` directo, sin subconsulta a `menu_categories`)
/// y evita que un ítem pueda terminar bajo una categoría de otro tenant.
model MenuItem {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  categoryId  String    @map("category_id") @db.Uuid
  name        String
  description String?
  price       Decimal   @db.Decimal(10, 2)
  imageUrl    String?   @map("image_url")
  isAvailable Boolean   @default(true) @map("is_available")
  position    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([tenantId, categoryId, position])
  @@map("menu_items")
}

/// Cliente final del comercio — Sprint 5 (WhatsApp conectado). Primera
/// fuente real: se crea/actualiza automáticamente al llegar un mensaje de
/// WhatsApp (`whatsapp.service.ts`), identificado por `phone` (el `wa_id`
/// que manda Meta). `name` es opcional porque WhatsApp solo entrega un
/// nombre de perfil libre, sin separación en nombre/apellido — no se
/// reutilizó la forma `firstName`/`lastName` del tipo de Sprint 3
/// (`apps/web/.../features/customers/types/customer.ts`) porque ese tipo
/// era un placeholder de frontend sin contrato real todavía (documentado
/// así en su momento); este es el primero real y reflejar lo que WhatsApp
/// realmente entrega. Sin RLS todavía — ver nota en `AiMessage`.
model Customer {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String?
  phone     String
  email     String?
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations AiConversation[]

  @@unique([tenantId, phone])
  @@map("customers")
}

enum AiConversationChannel {
  whatsapp

  @@map("ai_conversation_channel")
}

enum AiConversationStatus {
  open
  closed

  @@map("ai_conversation_status")
}

/// Hilo de conversación de un cliente por canal — Sprint 5. Una sola fila
/// abierta por `(tenantId, customerId, channel)`: el webhook busca la
/// conversación existente antes de crear una nueva (`@@unique` de abajo lo
/// garantiza a nivel de base también, no solo en el service).
model AiConversation {
  id            String                 @id @default(uuid()) @db.Uuid
  tenantId      String                 @map("tenant_id") @db.Uuid
  customerId    String                 @map("customer_id") @db.Uuid
  channel       AiConversationChannel  @default(whatsapp)
  status        AiConversationStatus   @default(open)
  lastMessageAt DateTime?              @map("last_message_at")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@unique([tenantId, customerId, channel])
  @@index([tenantId, status])
  @@map("ai_conversations")
}

enum AiMessageDirection {
  inbound
  outbound

  @@map("ai_message_direction")
}

/// Mensaje individual de una conversación — Sprint 5. `whatsappMessageId`
/// es el `wamid` que manda Meta en cada mensaje entrante (y el que devuelve
/// la Cloud API al enviar uno saliente) — `@unique` es el mecanismo real de
/// idempotencia: el webhook intenta crear el mensaje y, si ya existe
/// (violación de unicidad), lo trata como ya procesado, sin duplicar nada.
///
/// `Customer`/`AiConversation`/`AiMessage` quedan sin RLS por ahora, a
/// diferencia de `tenants`/`menu_*`: todo el acceso de este sprint es o
/// bien del webhook (sin usuario autenticado — no hay `current_user_id`
/// que setear para que las políticas de RLS tengan algo que evaluar) o
/// bien interno al mismo módulo (`whatsapp.service.ts` ya filtra por
/// `tenantId` en cada query). Cuando un sprint futuro exponga estas tablas
/// a un endpoint de usuario (dashboard de conversaciones), ahí sí
/// corresponde sumar RLS con `withUserContext`, igual que `menu_*`.
model AiMessage {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  conversationId    String             @map("conversation_id") @db.Uuid
  direction         AiMessageDirection
  content           String
  whatsappMessageId String?            @unique @map("whatsapp_message_id")
  createdAt         DateTime           @default(now()) @map("created_at")

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId, conversationId, createdAt])
  @@map("ai_messages")
}
