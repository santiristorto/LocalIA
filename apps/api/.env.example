# LocalIA API — variables de entorno
# Copiar como .env y completar. Nunca versionar el .env real.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# REQUERIDO — URL de tu proyecto de Supabase (Project Settings > API > Project URL).
# Se usa para construir la URL del JWKS público del proyecto
# (https://<project-id>.supabase.co/auth/v1/.well-known/jwks.json), contra
# la que se verifica la firma de cada JWT de sesión (middleware `authenticate`).
#
# NOTA: ya NO se usa ningún "JWT Secret" acá. Supabase migró la firma de
# tokens de HS256 (secreto compartido) a claves asimétricas (ES256/RSA) —
# el endpoint JWKS solo publica claves *públicas*, no hay ningún secreto
# que copiar ni guardar del lado del backend. Sin SUPABASE_URL la app no
# arranca (validado con Zod al inicio).
SUPABASE_URL=

# REQUERIDO — el módulo `tenants` ya consulta la base.
# Usar el connection string de "Transaction pooler" del dashboard de
# Supabase (Project Settings > Database > Connect), puerto 6543 — es la
# conexión pooleada (Supavisor) para el tráfico normal de la aplicación.
# Backend Architecture Specification §17. Si ves errores de "prepared
# statement already exists", agregá `?pgbouncer=true` al final.
DATABASE_URL=

# REQUERIDO. Usar el connection string de "Session pooler" del dashboard de
# Supabase (mismo lugar que arriba), puerto 5432 — NO el de "Direct
# connection" (`db.<project-ref>.supabase.co`): ese host es solo IPv6 salvo
# que tengas el add-on de IPv4 de Supabase, y casi ninguna red local puede
# alcanzarlo (falla con `P1001: Can't reach database server`). El pooler en
# modo sesión sí soporta las operaciones DDL que necesita
# `prisma migrate deploy` — Backend Architecture Specification §17.
DIRECT_URL=

# Se completa cuando el backend necesite operaciones administrativas sobre
# Supabase Auth (invitar empleados, revocar sesiones) — próximos sprints.
SUPABASE_SERVICE_ROLE_KEY=
