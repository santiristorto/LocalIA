# LocalIA API — variables de entorno
# Copiar como .env y completar. Nunca versionar el .env real.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Se completa en el Sprint 1, cuando exista el primer modelo real (tenants).
# Conexión pooleada (Supavisor) para el tráfico de la aplicación —
# Backend Architecture Specification §17.
DATABASE_URL=

# Conexión directa (no pooleada), usada exclusivamente por `prisma migrate` —
# Backend Architecture Specification §17.
DIRECT_URL=

# Se completan en el Sprint 2 (Autenticación multi-tenant).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
